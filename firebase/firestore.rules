rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 보정 기록(corrections): 학습 데이터 수집용.
    // - create(추가): 누구나 가능. 단, 형식이 올바를 때만(악용 방지).
    // - read/update/delete: 금지(관리자는 Firebase 콘솔에서 직접 조회).
    match /corrections/{docId} {
      allow create: if isValidCorrection(request.resource.data);
      allow read, update, delete: if false;
    }

    // 그 외 모든 경로는 차단(기존 momgagym-cms 데이터 보호).
    // ※ 기존에 다른 컬렉션 규칙이 있으면 이 블록과 합쳐서 쓰세요.

    function isValidCorrection(d) {
      return d.action in ['merge', 'split', 'adjust']
        && d.poomsae is string
        && d.size() < 30;  // 필드 수 제한(스팸 방지)
    }
  }
}
