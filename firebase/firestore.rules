rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 보정 기록(corrections): 학습 데이터 수집용.
    // - create(추가): 누구나 가능. 단, 형식이 올바를 때만(악용 방지).
    // - read/update/delete: 금지(관리자는 Firebase 콘솔에서 직접 조회).
    match /corrections/{docId} {
      allow create: if isValidCorrection(request.resource.data);
      allow read, update, delete: if false;
    }

    // ── 파트너 배너 설정 (신규, corrections/CMS와 완전히 분리된 경로) ──
    // - read: 누구나(앱을 여는 모든 사용자가 배너를 봐야 하므로).
    // - write: PIN이 일치할 때만. PIN은 www/index.html의 ADMIN_PIN 상수와 반드시 같은 값이어야 함
    //   (하나를 바꾸면 다른 하나도 같이 바꿀 것). 로그인 시스템이 없어 실제 사용자 인증은 아니며,
    //   민감하지 않은 홍보 배너용으로 설계된 경량 보호임.
    match /app_config/banner {
      allow read: if true;
      allow write: if request.resource.data.pin == "0713"
        && request.resource.data.keys().hasOnly(['pin', 'enabled', 'imageUrl', 'linkUrl', 'startAt', 'endAt'])
        && request.resource.data.enabled is bool;
    }

    // 그 외 모든 경로는 차단(기존 momgagym-cms 데이터 보호).
    // ※ 기존에 다른 컬렉션 규칙이 있으면 이 블록과 합쳐서 쓰세요.

    function isValidCorrection(d) {
      return d.action in ['merge', 'split', 'adjust']
        && d.poomsae is string
        && d.size() < 30;  // 필드 수 제한(스팸 방지)
    }
  }
}
