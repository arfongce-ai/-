rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 보정 기록(corrections): 학습 데이터 수집용.
    // - create(추가): 누구나 가능. 단, 형식이 올바를 때만(악용 방지).
    // - read: 인증된 관리자 계정(아래 ADMIN_EMAILS)만 가능 — "학습 리포트" 기능용.
    //   ⚠️ 배포 전 확인: ADMIN_EMAILS를 실제 관리자 이메일로 바꾸고, Firebase 콘솔
    //   Authentication에서 같은 이메일로 사용자를 먼저 만들어 둬야 로그인이 된다.
    //   (Authentication → Sign-in method → 이메일/비밀번호 사용 설정 → Users → 사용자 추가)
    // - update/delete: 금지(그 누구도 기존 기록을 고치거나 지울 수 없음 — 데이터 무결성 보호).
    match /corrections/{docId} {
      allow create: if isValidCorrection(request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // 개인정보 없는 분석 요약. 관리자 리포트와 전체 학습 통계의 원본으로 사용한다.
    match /learning_reports/{docId} {
      allow create: if isValidLearningReport(request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // 전후 비교 카드 리포트. 원본 영상은 저장하지 않고 요약 수치와 쉬운 설명만 저장한다.
    match /compare_reports/{docId} {
      allow create: if isValidCompareReport(request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // GPT·지도자 검수 원본: 일반 사용자 보정과 분리해 출처 위조를 막는다.
    // 관리자 화면에서 가져온 명시적 검수 JSON만 이 컬렉션에 저장한다.
    match /calibration_reviews/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && isValidCalibrationReview(request.resource.data);
      allow update, delete: if false;
    }

    // ── 파트너 배너 설정 (신규, corrections/CMS와 완전히 분리된 경로) ──
    // - read: 누구나(앱을 여는 모든 사용자가 배너를 봐야 하므로).
    // - write: Firebase Authentication으로 확인된 관리자만 가능.
    match /app_config/banner {
      allow read: if true;
      allow write: if isAdmin() && isValidBanner(request.resource.data);
    }

    // ── 학습된 경계 타이밍 보정 (신규) ──
    // 배경: "학습 리포트"에서 관리자가 승인한 체계적 치우침(위치키→초 단위 보정)을 게시하면,
    // 모든 사용자의 앱이 이 값을 읽어 자동 감지 경계에 작은 타이밍 보정만 더한다(동작 분류·
    // 명칭·개수는 절대 바꾸지 않음 — 클라이언트에서도 ±1.5초로 다시 한번 제한함).
    // - read: 누구나(전 사용자의 분석에 반영되어야 하므로).
    // - write: 인증된 관리자만(위 corrections read와 같은 ADMIN_EMAILS 기준).
    match /app_config/boundary_bias {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.size() < 200; // 문서 비대화 방지(스팸/실수 보호).
    }

    // 그 외 모든 경로는 차단(기존 momgagym-cms 데이터 보호).
    // ※ 기존에 다른 컬렉션 규칙이 있으면 이 블록과 합쳐서 쓰세요.

    // 누구나 쓸 수 있는 기록이라 앱이 실제로 보내는 필드만 허용하고(파일명 등 거부),
    // 글자 수·목록 길이를 묶어 스팸·무료 할당량 소진을 막는다. 출처 신뢰(trusted_provenance)는 주장할 수 없다.
    function isValidCorrection(d) {
      return d.action in ['merge', 'split', 'adjust', 'cascade_adjust', 'confirm_all']
        && d.keys().hasOnly(['ts', 'poomsae', 'poomsae_name', 'video_duration', 'auto_method',
          'review_session_id', 'correction_revision', 'action', 'trusted_provenance', 'created',
          'removed_boundary_time', 'merged_segment_index', 'auto_segment_count', 'result_segment_count',
          'result_boundary_ratios', 'segment_index', 'segment_start', 'segment_end', 'split_at',
          'split_ratio', 'boundary_index', 'auto_time', 'user_time', 'delta_seconds',
          'applied_bias_seconds', 'target_total_bias_seconds', 'shifted_count', 'boundary_count',
          'explicit_review'])
        && d.poomsae is string && d.poomsae.size() <= 80
        && optString(d, 'poomsae_name', 120)
        && optString(d, 'auto_method', 80)
        && optString(d, 'review_session_id', 100)
        && optString(d, 'ts', 40)
        && optNumber(d, 'video_duration') && optNumber(d, 'correction_revision')
        && optNumber(d, 'removed_boundary_time') && optNumber(d, 'merged_segment_index')
        && optNumber(d, 'auto_segment_count') && optNumber(d, 'result_segment_count')
        && optNumber(d, 'segment_index') && optNumber(d, 'segment_start') && optNumber(d, 'segment_end')
        && optNumber(d, 'split_at') && optNumber(d, 'split_ratio') && optNumber(d, 'boundary_index')
        && optNumber(d, 'auto_time') && optNumber(d, 'user_time') && optNumber(d, 'delta_seconds')
        && optNumber(d, 'applied_bias_seconds') && optNumber(d, 'target_total_bias_seconds')
        && optNumber(d, 'shifted_count') && optNumber(d, 'boundary_count')
        && (d.get('result_boundary_ratios', null) == null
          || (d.result_boundary_ratios is list && d.result_boundary_ratios.size() <= 64))
        && d.get('trusted_provenance', false) == false
        && (d.get('explicit_review', true) is bool)
        && serverCreated(d)
        && d.size() < 30;  // 필드 수 제한(스팸 방지)
    }
    function optString(d, key, maxLength) {
      return d.get(key, null) == null || (d[key] is string && d[key].size() <= maxLength);
    }
    // 숫자 칸은 숫자 또는 null만(숫자 칸에 긴 글을 넣는 우회 차단).
    function optNumber(d, key) {
      return d.get(key, null) == null || d[key] is number;
    }
    // 생성 시각은 서버 시간만(과거 날짜로 위조 금지). 예전 테스트처럼 없는 것도 허용.
    function serverCreated(d) {
      return !('created' in d) || d.created == request.time;
    }
    function isValidLearningReport(d) {
      return d.schema in ['poomsae-learning-report-v1', 'poomsae-learning-report-v2', 'poomsae-learning-report-v3']
        && d.poomsae is string
        && d.training_mode in ['exam', 'competition']
        && d.score_100 is number
        && d.detection_rate is number
        && (d.schema == 'poomsae-learning-report-v1'
          || (d.camera_count is number
            && d.camera_count >= 1
            && d.camera_count <= 3
            && d.analysis_confidence is number
            && d.analysis_confidence >= 0
            && d.analysis_confidence <= 1))
        && d.poomsae.size() <= 80
        && d.issue_counts is list && d.issue_counts.size() <= 20
        && d.needed_training is list && d.needed_training.size() <= 20
        && !('file' in d)
        && serverCreated(d)
        && (d.schema == 'poomsae-learning-report-v1'
          || (isValidTeamLearningData(d) && isValidPairLearningData(d) && isValidIndividualLearningData(d)))
        && (d.schema != 'poomsae-learning-report-v3' || isValidEventLearningData(d))
        && d.size() < 32;
    }
    function isValidEventLearningData(d) {
      return d.expected_athletes is number
        && d.expected_athletes >= 1
        && d.expected_athletes <= 3
        && d.recognition_rate is number
        && d.recognition_rate >= 0
        && d.recognition_rate <= 1
        && d.data_quality_level in ['low', 'medium', 'high']
        && d.usable_for_learning is bool
        && d.event_data is map
        && d.event_data.schema == 'poomsae-event-quality-v1'
        && d.event_data.event == d.competition_event
        && d.event_data.expected_athletes == d.expected_athletes
        && d.event_data.recognition_rate is number
        && d.event_data.recognition_rate >= 0
        && d.event_data.recognition_rate <= 1
        && d.event_data.calibrated_confidence is number
        && d.event_data.calibrated_confidence >= 0
        && d.event_data.calibrated_confidence <= 1
        && d.event_data.average_visibility is number
        && d.event_data.average_visibility >= 0
        && d.event_data.average_visibility <= 1
        && d.event_data.track_stability is number
        && d.event_data.track_stability >= 0
        && d.event_data.track_stability <= 1
        && d.event_data.quality_level in ['low', 'medium', 'high']
        && d.event_data.usable_for_learning is bool
        && d.event_data.athlete_profiles is list
        && d.event_data.athlete_profiles.size() <= 3
        && d.event_data.segments is list
        && d.event_data.segments.size() <= 80
        && (d.competition_event != 'individual' || d.expected_athletes == 1)
        && (d.competition_event != 'pair' || d.expected_athletes == 2)
        && (d.competition_event != 'team' || d.expected_athletes == 3)
        && d.event_data.size() < 18;
    }
    function isValidTeamLearningData(d) {
      return d.competition_event != 'team'
        || (d.team_data is map
          && d.team_data.schema == 'poomsae-team-analysis-v1'
          && d.team_data.expected_athletes == 3
          && d.team_data.athlete_count is number
          && d.team_data.athlete_count >= 0
          && d.team_data.athlete_count <= 3
          && d.team_data.average_three_pose_ratio is number
          && d.team_data.average_three_pose_ratio >= 0
          && d.team_data.average_three_pose_ratio <= 1
          && d.team_data.athlete_profiles is list
          && d.team_data.athlete_profiles.size() <= 3
          && d.team_data.segments is list
          && d.team_data.segments.size() <= 80
          && d.team_data.size() < 12);
    }
    function isValidIndividualLearningData(d) {
      return d.competition_event != 'individual'
        || (d.individual_data is map
          && d.individual_data.schema == 'poomsae-individual-analysis-v1'
          && d.individual_data.expected_athletes == 1
          && d.individual_data.accuracy_score_4 is number
          && d.individual_data.accuracy_score_4 >= 0
          && d.individual_data.accuracy_score_4 <= 4
          && d.individual_data.presentation_score_6 is number
          && d.individual_data.presentation_score_6 >= 0
          && d.individual_data.presentation_score_6 <= 6
          && d.individual_data.segments is list
          && d.individual_data.segments.size() <= 80
          && d.individual_data.size() < 10);
    }
    function isValidPairLearningData(d) {
      return d.competition_event != 'pair'
        || (d.pair_data is map
          && d.pair_data.schema == 'poomsae-pair-analysis-v1'
          && d.pair_data.expected_athletes == 2
          && d.pair_data.athlete_count is number
          && d.pair_data.athlete_count >= 0
          && d.pair_data.athlete_count <= 2
          && d.pair_data.average_two_pose_ratio is number
          && d.pair_data.average_two_pose_ratio >= 0
          && d.pair_data.average_two_pose_ratio <= 1
          && d.pair_data.athlete_profiles is list
          && d.pair_data.athlete_profiles.size() <= 2
          && d.pair_data.segments is list
          && d.pair_data.segments.size() <= 80
          && d.pair_data.size() < 12);
    }
    function isValidCompareReport(d) {
      return d.schema == 'poomsae-compare-report-v1'
        && d.before_duration is number
        && d.after_duration is number
        && d.delta_seconds is number
        && d.delta_percent is number
        && d.overlap_score is number
        && d.align_mode in ['none', 'ankle', 'shoulder', 'head', 'hip']
        && d.child_summary is string && d.child_summary.size() <= 600
        && d.child_time_text is string && d.child_time_text.size() <= 300
        && d.child_tip is string && d.child_tip.size() <= 300
        // 영상 파일명(학생 이름·나이가 들어갈 수 있음)은 받지 않는다.
        && !('before_file' in d) && !('after_file' in d)
        && noSourceFile(d.get('before_analysis', null)) && noSourceFile(d.get('after_analysis', null))
        && serverCreated(d)
        && d.size() < 36;
    }
    function noSourceFile(link) {
      return link == null || (link is map && !('source_file' in link) && link.size() < 24);
    }
    function isValidCalibrationReview(d) {
      return d.action in ['merge', 'split', 'adjust', 'cascade_adjust', 'confirm_all']
        && d.poomsae is string
        && d.explicit_review == true
        && d.trusted_provenance == true
        && d.review_status in ['gpt_reviewed', 'expert_approved']
        && d.result_boundary_ratios is list
        && d.size() < 30;
    }
    function isValidBanner(d) {
      return d.keys().hasOnly(['enabled', 'imageUrl', 'linkUrl', 'startAt', 'endAt'])
        && d.enabled is bool
        && d.imageUrl is string
        && d.imageUrl.size() <= 900000
        && d.linkUrl is string
        && d.linkUrl.size() <= 2048
        && d.startAt is number
        && d.endAt is number
        && d.startAt < d.endAt;
    }
    // 이메일 인증까지 마친 관리자 계정만. 규칙을 게시하기 전에 앱 관리자 화면에서
    // '인증 메일 보내기' → 메일의 링크를 누르고 다시 로그인해야 한다(안 하면 관리자 기능이 막힘).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email in ADMIN_EMAILS();
    }
    // 학습 리포트를 읽을 수 있는 관리자 이메일 목록. 배포 전 실제 이메일로 교체할 것.
    function ADMIN_EMAILS() {
      return ['momgagym@naver.com'];
    }
  }
}
